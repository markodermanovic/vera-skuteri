---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stranica nije pronađena" namespace="not-found" noindex>
  <section class="container-page py-24 text-center">
    <p class="bg-gradient-to-br from-brand to-brand-dark bg-clip-text text-8xl font-extrabold text-transparent sm:text-9xl" aria-hidden="true">404</p>
    <h1 class="mt-4 text-3xl font-extrabold">Ova stranica ne postoji</h1>
    <p data-reveal class="mt-3 text-muted">Možda je model uklonjen iz ponude ili je link pogrešan.</p>
    <div data-reveal class="mt-8 flex justify-center gap-3">
      <a href="/skuteri" class="btn-primary">Pogledaj skutere</a>
      <a href="/kontakt" class="btn-ghost">Kontakt</a>
    </div>
  </section>
</Layout>
