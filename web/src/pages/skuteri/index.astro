---
import Layout from '../../layouts/Layout.astro';
import ScooterCard from '../../components/ScooterCard.astro';
import { getBrands, getCategories, getScooters } from '../../lib/content';

const [scooters, categories, brands] = await Promise.all([getScooters(), getCategories(), getBrands()]);
const usedBrands = brands.filter((b) => scooters.some((s) => s.brand?.slug === b.slug));
---

<Layout title="Skuteri" namespace="catalog" description="Katalog električnih skutera – uporedite domet, brzinu, snagu i dostupne boje.">
  <section class="container-page pt-12">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">Skuteri</h1>
    <p data-reveal class="mt-3 max-w-2xl text-muted">Uporedite modele po dometu, brzini i ceni. Svaki model je dostupan u više boja.</p>

    <form id="filters" data-reveal class="mt-8 grid gap-3 rounded-3xl border border-line bg-white p-4 sm:grid-cols-2 lg:grid-cols-5" role="search" aria-label="Filtriranje skutera">
      <label class="block">
        <span class="label">Kategorija</span>
        <select name="kategorija" class="field">
          <option value="">Sve</option>
          {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="label">Brend</span>
        <select name="brend" class="field">
          <option value="">Svi</option>
          {usedBrands.map((b) => <option value={b.slug}>{b.name}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="label">Cena do (RSD)</span>
        <input type="number" name="cena" min="0" step="5000" inputmode="numeric" placeholder="Bilo koja" class="field" />
      </label>
      <label class="block">
        <span class="label">Domet od (km)</span>
        <input type="number" name="domet" min="0" step="5" inputmode="numeric" placeholder="Bilo koji" class="field" />
      </label>
      <label class="block">
        <span class="label">Sortiraj</span>
        <select name="sort" class="field">
          <option value="">Preporučeno</option>
          <option value="cena-rastuce">Cena: niža prvo</option>
          <option value="cena-opadajuce">Cena: viša prvo</option>
          <option value="domet">Najveći domet</option>
          <option value="naziv">Naziv A–Ž</option>
        </select>
      </label>
    </form>

    <p id="result-count" class="mt-6 text-sm text-muted" aria-live="polite">{scooters.length} modela</p>

    <div id="grid" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {scooters.map((s) => <ScooterCard scooter={s} />)}
    </div>
    <div id="empty" class="mt-4 hidden rounded-3xl border border-line bg-white p-10 text-center">
      <p class="font-semibold">Nema modela koji odgovaraju filterima.</p>
      <button type="button" id="reset" class="btn-ghost mt-4">Poništi filtere</button>
    </div>
  </section>
</Layout>
