---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ScooterArt from '../../components/ScooterArt.astro';
import ScooterCard from '../../components/ScooterCard.astro';
import { getScooters } from '../../lib/content';
import { formatPrice, specRows } from '../../lib/format';
import type { Scooter } from '../../lib/types';

export const getStaticPaths = (async () => {
  const scooters = await getScooters();
  return scooters.map((scooter) => ({
    params: { slug: scooter.slug },
    props: {
      scooter,
      related: scooters.filter((s) => s.id !== scooter.id && s.category?.slug === scooter.category?.slug).slice(0, 3),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  scooter: Scooter;
  related: Scooter[];
}
const { scooter, related } = Astro.props;
const variants = scooter.colorVariants;
const specs = [...specRows(scooter.mainSpecs), ...scooter.extraSpecs];
const inquiryHref = (variant?: string) =>
  `/kontakt?${new URLSearchParams({ model: scooter.slug, ...(variant ? { boja: variant } : {}) })}`;
const firstImage = variants.find((v) => v.images[0])?.images[0];
// Sve slike svih boja redom – za lightbox; offset[vi] je indeks prve slike te boje
const gallery = variants.flatMap((v) => v.images.map((img) => ({ img, color: v.name })));
const offset = variants.map((_, vi) => variants.slice(0, vi).reduce((n, v) => n + v.images.length, 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: scooter.name,
  description: scooter.excerpt,
  brand: scooter.brand && { '@type': 'Brand', name: scooter.brand.name },
  image: variants.flatMap((v) => v.images.map((i) => i.src)),
  url: new URL(`/skuteri/${scooter.slug}`, Astro.site).href,
  ...(!scooter.priceOnRequest && scooter.price != null && {
    offers: variants.map((v) => ({
      '@type': 'Offer',
      sku: v.sku,
      color: v.name,
      price: scooter.price,
      priceCurrency: 'RSD',
      availability: v.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    })),
  }),
};
---

<Layout
  namespace="scooter"
  title={scooter.seo?.title ?? scooter.name}
  description={scooter.seo?.description ?? scooter.excerpt}
  ogImage={scooter.seo?.ogImage ?? firstImage?.src}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container-page pt-8">
    <nav aria-label="Putanja" data-reveal class="text-sm text-muted">
      <ol class="flex flex-wrap gap-1.5">
        <li><a href="/" class="link-underline hover:text-brand">Početna</a> /</li>
        <li><a href="/skuteri" class="link-underline hover:text-brand">Skuteri</a> /</li>
        <li aria-current="page" class="text-ink">{scooter.name}</li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <!-- Galerija: jedan panel po varijanti boje -->
      <div data-reveal>
        {variants.map((v, vi) => (
          <div class="variant-panel" data-variant={v.name} hidden={vi !== 0}>
            <div class="aspect-[4/3] overflow-hidden rounded-[2rem] bg-[#ececec]">
              {v.images.length ? (
                <button
                  type="button"
                  class="open-lightbox group/zoom relative block size-full cursor-zoom-in"
                  data-lb-index={offset[vi]}
                  aria-label={`Otvori galeriju – ${scooter.name}, ${v.name}`}
                >
                  <img
                    class="main-image size-full object-cover transition-transform duration-700 ease-out-expo group-hover/zoom:scale-[1.03]"
                    src={v.images[0].src}
                    srcset={v.images[0].srcset}
                    sizes="(min-width: 1024px) 55vw, 100vw"
                    alt={v.images[0].alt}
                    width={v.images[0].width}
                    height={v.images[0].height}
                    loading={vi === 0 ? 'eager' : 'lazy'}
                    fetchpriority={vi === 0 ? 'high' : undefined}
                  />
                  <span class="absolute bottom-4 right-4 grid size-11 place-items-center rounded-full bg-white/90 text-ink shadow-lg transition-transform duration-300 group-hover/zoom:scale-110" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                  </span>
                </button>
              ) : (
                <ScooterArt color={v.hex} label={`${scooter.name} – ${v.name}`} class="size-full" />
              )}
            </div>
            {v.images.length > 1 && (
              <ul class="mt-3 grid grid-cols-5 gap-2">
                {v.images.map((img, ii) => (
                  <li>
                    <button
                      type="button"
                      class="thumb block aspect-square w-full overflow-hidden rounded-xl ring-2 ring-transparent transition hover:opacity-80 aria-pressed:ring-brand"
                      aria-pressed={ii === 0 ? 'true' : 'false'}
                      aria-label={`Prikaži sliku ${ii + 1}`}
                      data-src={img.src}
                      data-srcset={img.srcset}
                      data-alt={img.alt}
                      data-lb-index={offset[vi] + ii}
                    >
                      <img src={img.src} srcset={img.srcset} sizes="120px" alt="" loading="lazy" class="size-full object-cover" />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      <!-- Info -->
      <div>
        <p data-reveal class="text-sm font-semibold uppercase tracking-wider text-brand">{[scooter.brand?.name, scooter.category?.name].filter(Boolean).join(' · ')}</p>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">{scooter.name}</h1>
        {scooter.excerpt && <p data-reveal class="mt-4 text-lg text-ink/70">{scooter.excerpt}</p>}
        <p data-reveal class="mt-6 text-3xl font-extrabold text-brand">{formatPrice(scooter)}</p>

        {variants.length > 0 && (
          <fieldset data-reveal class="mt-8">
            <legend class="text-sm font-semibold">
              Boja: <span id="variant-name">{variants[0].name}</span>
              <span id="variant-stock" data-in-stock={String(variants[0].inStock)} class="group/stock ml-2 inline-flex items-center gap-1.5 rounded-full bg-paper px-2.5 py-0.5 text-xs font-semibold">
                <span class="size-2 rounded-full bg-amber-500 group-data-[in-stock=true]/stock:animate-pulse-ring group-data-[in-stock=true]/stock:bg-success" aria-hidden="true"></span>
                <span data-stock-label>{variants[0].inStock ? 'Na stanju' : 'Po porudžbini'}</span>
              </span>
            </legend>
            <div class="mt-3 flex flex-wrap gap-3">
              {variants.map((v, i) => (
                <label class="cursor-pointer" title={v.name}>
                  <input type="radio" name="variant" value={v.name} checked={i === 0} data-in-stock={String(v.inStock)} class="peer sr-only" />
                  <span class="block size-10 rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.15)] ring-2 ring-transparent ring-offset-2 ring-offset-paper transition duration-300 ease-out-expo hover:scale-110 active:scale-95 peer-checked:scale-110 peer-checked:ring-brand peer-focus-visible:ring-brand/50" style={`background:${v.hex}`}></span>
                  <span class="sr-only">{v.name}{v.inStock ? '' : ' (po porudžbini)'}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <div data-reveal class="mt-8 flex flex-wrap gap-3">
          <a id="inquiry-link" href={inquiryHref(variants[0]?.name)} data-base={inquiryHref()} class="btn-primary">Pošalji upit za ovaj model <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#specifikacije" data-barba-prevent class="btn-ghost">Specifikacije</a>
        </div>
        <p data-reveal class="mt-3 text-sm text-muted">Bez online plaćanja – javljamo vam se telefonom ili mejlom sa ponudom.</p>
      </div>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <section id="specifikacije" aria-labelledby="spec-heading" class="scroll-mt-24">
        <h2 id="spec-heading" data-reveal class="text-2xl font-extrabold">Specifikacije</h2>
        <dl class="mt-4 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-white">
          {specs.map((row) => (
            <div data-reveal class="grid grid-cols-2 gap-4 px-5 py-3 text-sm transition-colors hover:bg-brand-soft/50">
              <dt class="text-muted">{row.label}</dt>
              <dd class="font-semibold">{row.value}</dd>
            </div>
          ))}
        </dl>
      </section>
      {scooter.descriptionHtml && (
        <section aria-labelledby="opis-heading">
          <h2 id="opis-heading" data-reveal class="text-2xl font-extrabold">Opis</h2>
          <div data-reveal class="prose-basic mt-4" set:html={scooter.descriptionHtml} />
        </section>
      )}
    </div>

    {related.length > 0 && (
      <section class="mt-20" aria-labelledby="slicni">
        <h2 id="slicni" data-reveal class="text-2xl font-extrabold">Slični modeli</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((s) => <ScooterCard scooter={s} />)}
        </div>
      </section>
    )}
  </div>

  <!-- Lightbox: sve slike u punoj veličini, prevlačenje / strelice / tastatura (pages/scooter.ts) -->
  {gallery.length > 0 && (
    <dialog id="lightbox" class="lightbox fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none bg-black/95 p-0 text-white backdrop:bg-black/80" aria-label={`Galerija – ${scooter.name}`}>
      <div class="flex size-full flex-col">
        <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
          <p class="text-sm text-white/80"><span data-lb-count>1</span> / {gallery.length} · <span data-lb-color>{gallery[0].color}</span></p>
          <button type="button" data-lb-close class="grid size-11 place-items-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="Zatvori galeriju">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
        <div class="relative min-h-0 flex-1">
          <ul data-lb-track class="flex size-full snap-x snap-mandatory overflow-x-auto overscroll-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {gallery.map(({ img, color }, i) => (
              <li class="flex h-full w-full shrink-0 snap-center items-center justify-center px-4 sm:px-20" data-color={color}>
                <img src={img.src} srcset={img.srcset} sizes="100vw" alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" class="max-h-[calc(100dvh-10.5rem)] w-auto max-w-full rounded-xl object-contain sm:max-h-[calc(100dvh-11.5rem)]" />
              </li>
            ))}
          </ul>
          {gallery.length > 1 && (
            <>
              <button type="button" data-lb-prev class="absolute left-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 backdrop-blur transition hover:bg-white/25 max-sm:hidden" aria-label="Prethodna slika">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <button type="button" data-lb-next class="absolute right-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 backdrop-blur transition hover:bg-white/25 max-sm:hidden" aria-label="Sledeća slika">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </>
          )}
        </div>
        {gallery.length > 1 && (
          <ul class="flex justify-center gap-2 overflow-x-auto px-4 py-4" aria-label="Slike">
            {gallery.map(({ img }, i) => (
              <li>
                <button type="button" data-lb-go={i} class="block size-14 overflow-hidden rounded-lg opacity-50 ring-2 ring-transparent transition hover:opacity-90 aria-[current=true]:opacity-100 aria-[current=true]:ring-white sm:size-16" aria-label={`Slika ${i + 1}`}>
                  <img src={img.src} srcset={img.srcset} sizes="64px" alt="" loading="lazy" class="size-full object-cover" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>
    </dialog>
  )}
</Layout>
