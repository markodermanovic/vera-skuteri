---
import Layout from '../layouts/Layout.astro';
import ScooterCard from '../components/ScooterCard.astro';
import ShowcaseScooter from '../components/ShowcaseScooter.astro';
import { getCategories, getFeaturedScooters, getSettings } from '../lib/content';

const [featured, categories, settings] = await Promise.all([getFeaturedScooters(), getCategories(), getSettings()]);
---

<Layout title={settings.companyName} namespace="home">
  <section class="container-page pt-8 sm:pt-12">
    <div data-hero class="relative isolate flex min-h-[34rem] items-end overflow-hidden rounded-[2rem] bg-brand-dark px-6 pb-14 pt-24 text-white sm:min-h-[38rem] sm:px-14 sm:pb-16 lg:min-h-[42rem] lg:items-center lg:pb-24">
      <!-- Pozadinski video (bez zvuka); pages/home.ts ga pušta, bez JS-a ili uz reduced-motion ostaje poster -->
      <video
        data-hero-video
        class="absolute inset-0 -z-20 size-full scale-[1.02] object-cover"
        poster="/hero/xtreme-motors-poster.jpg"
        muted
        playsinline
        preload="none"
        aria-hidden="true"
      >
        <source src="/hero/xtreme-motors.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-dark/95 via-brand/70 to-brand/10" aria-hidden="true"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/50 via-transparent to-black/10" aria-hidden="true"></div>

      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-white/75">Električni skuteri</p>
        <h1 class="mt-4 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          Vozi pametnije.<br />Pronađi svoj skuter.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">
          Električni skuteri za svakodnevnu vožnju, u više boja. Izaberite model, pošaljite upit – mi vas zovemo sa svim detaljima.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/skuteri" class="btn-light">Pogledaj sve skutere <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/kontakt" class="btn border border-white/40 backdrop-blur-sm hover:border-white hover:bg-white/10">Pošalji upit</a>
        </div>
      </div>

      <!-- Kontrola videa i tanka traka napretka -->
      <button
        type="button"
        data-hero-toggle
        hidden
        class="absolute bottom-5 right-5 grid size-11 place-items-center rounded-full border border-white/40 bg-black/20 backdrop-blur-sm transition hover:bg-white/15 sm:bottom-6 sm:right-6"
        aria-label="Pauziraj video"
      >
        <svg data-icon="pause" viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        <svg data-icon="play" viewBox="0 0 24 24" class="hidden size-4" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </button>
      <div class="absolute inset-x-0 bottom-0 h-[3px] bg-white/10" aria-hidden="true">
        <div data-hero-progress class="h-full w-full origin-left scale-x-0 bg-white/70"></div>
      </div>
    </div>
  </section>

  <section class="container-page mt-12 sm:mt-16">
    <div class="rounded-[2rem] border border-line bg-white px-6 py-10 sm:px-14 sm:py-14">
      <ShowcaseScooter />
    </div>
  </section>

  {categories.length > 1 && (
    <section class="container-page mt-20" aria-labelledby="kategorije">
      <h2 id="kategorije" data-reveal class="text-2xl font-extrabold sm:text-3xl">Kategorije</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {categories.map((c, i) => (
          <li data-reveal>
            <a href={`/skuteri?kategorija=${c.slug}`} class="group relative block h-full overflow-hidden rounded-3xl border border-line bg-white p-6 transition-colors duration-500 hover:border-brand">
              <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-brand transition-transform duration-500 ease-out-expo group-hover:scale-x-100" aria-hidden="true"></span>
              <span class="text-xs font-bold text-brand">0{i + 1}</span>
              <p class="mt-2 flex items-center justify-between text-lg font-bold">
                {c.name}
                <span class="text-brand transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
              </p>
              {c.description && <p class="mt-1 text-sm text-muted">{c.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {featured.length > 0 && (
    <section class="container-page mt-20" aria-labelledby="izdvojeno">
      <div class="flex items-end justify-between gap-4" data-reveal>
        <h2 id="izdvojeno" class="text-2xl font-extrabold sm:text-3xl">Izdvojeni modeli</h2>
        <a href="/skuteri" class="link-underline text-sm font-semibold text-brand">Svi skuteri →</a>
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((s) => <ScooterCard scooter={s} />)}
      </div>
    </section>
  )}

  <section class="container-page mt-20">
    <div data-reveal class="grid gap-6 rounded-[2rem] bg-ink p-8 text-white sm:grid-cols-[1fr_auto] sm:items-center sm:p-12">
      <div>
        <h2 class="text-2xl font-extrabold sm:text-3xl">Niste sigurni koji model je za vas?</h2>
        <p class="mt-2 text-white/70">Pozovite nas na <a class="link-underline font-semibold text-white" href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a> ili pošaljite upit – pomoći ćemo vam da izaberete.</p>
      </div>
      <a href="/kontakt" class="btn-primary">Kontaktirajte nas <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
