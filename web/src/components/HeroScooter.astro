---
// Hero skuter u duhu industrijskog dizajna: skica → linije → render → oznake → vožnja.
// Animaciju radi scripts/pages/home.ts; bez JS-a (ili uz reduced-motion) prikazuje se gotov crtež.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const CY = 292;
const wheels = [
  { id: 'rear', cx: 150, hub: 17 },
  { id: 'front', cx: 492, hub: 9 },
];
const spoke = (cx: number, a: number, r = 40) =>
  `M${cx} ${CY} L${(cx + r * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(CY + r * Math.sin((a * Math.PI) / 180)).toFixed(1)}`;

// Konture (iste putanje koriste i ispune rendera)
const shield = 'M440 110 C 470 112 492 140 486 178 C 480 214 452 238 420 252';
const floor = 'M420 252 H 270 C 246 238 238 214 250 196';
const tail = 'M250 196 L 180 186 C 130 186 92 210 86 244';
const seat = 'M226 186 C 238 166 330 162 352 174 C 360 180 356 190 342 192 L 234 194 C 226 194 222 190 226 186 Z';
const topCase = 'M118 140 H 176 C 184 140 188 146 186 154 L 182 176 C 181 180 178 182 174 182 H 120 C 116 182 113 180 112 176 L 108 152 C 107 145 111 140 118 140 Z';

const callouts = [
  { id: 'led', dot: [466, 150], path: 'M466 150 L 520 76 H 612', text: 'LED far', at: [612, 68], anchor: 'end' },
  { id: 'brake', dot: [508, 300], path: 'M508 300 L 548 380 H 636', text: 'Disk kočnica', at: [636, 372], anchor: 'end' },
  { id: 'battery', dot: [344, 269], path: 'M344 269 L 330 384 H 160', text: 'Baterija do 72V', at: [322, 376], anchor: 'end' },
  { id: 'case', dot: [147, 140], path: 'M147 140 L 176 64 H 300', text: 'Zadnji kofer', at: [180, 56], anchor: 'start' },
];
---

<svg
  data-hero-scooter
  viewBox="0 0 640 400"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hs-beam" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.6" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="hs-glow">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="hs-shadow">
      <stop offset="0" stop-color="#000" stop-opacity="0.45" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hs-paint" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e4e4e7" />
    </linearGradient>
    <filter id="hs-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <!-- "Četkica" rendera: pravougaonik koji se širi sleva nadesno -->
    <clipPath id="hs-reveal"><rect data-hs-reveal x="0" y="0" width="640" height="400" /></clipPath>
  </defs>

  <!-- 1. Skica: konstrukcione linije i perspektiva -->
  <g data-hs-sketch stroke-width="1.2" stroke-opacity="0.45" opacity="0">
    <path d="M40 350 L 610 336" />
    <path d="M70 362 L 600 358" />
    <path d="M92 292 L 560 292" stroke-dasharray="3 7" />
    <path d="M150 210 V 372" stroke-dasharray="3 7" />
    <path d="M492 200 V 372" stroke-dasharray="3 7" />
    <path d="M426 86 C 470 98 500 142 494 186 C 488 226 456 248 410 262" />
    <path d="M214 178 C 260 160 336 158 364 172" />
    <path d="M78 252 C 120 214 182 196 262 200" />
    <path d="M440 100 L 476 312" />
  </g>

  <!-- Brzinske linije i put -->
  <g data-hs-speed stroke-width="2.5" opacity="0">
    <path d="M14 128 H74" stroke-opacity="0.5" />
    <path d="M0 168 H48" stroke-opacity="0.35" />
    <path d="M22 206 H72" stroke-opacity="0.45" />
    <path d="M4 248 H40" stroke-opacity="0.3" />
  </g>
  <path data-hs-road d="M0 354 H640" stroke-width="3" stroke-opacity="0.45" stroke-dasharray="34 22" />
  <ellipse data-hs-shadow cx="322" cy="352" rx="250" ry="16" fill="url(#hs-shadow)" stroke="none" />

  <!-- Snop svetla -->
  <path data-hs-beam d="M506 144 L640 100 L640 212 L506 162 Z" fill="url(#hs-beam)" stroke="none" />
  <circle data-hs-glow cx="500" cy="152" r="22" fill="url(#hs-glow)" stroke="none" />

  <!-- Karoserija (lagano radi na amortizerima) -->
  <g data-hs-body>
    <!-- 3. Render: ispune ispod kontura -->
    <g data-hs-render clip-path="url(#hs-reveal)" stroke="none">
      <path d={`M440 110 C 470 112 492 140 486 178 C 480 214 452 238 420 252 H 270 C 246 238 238 214 250 196 L 262 196 C 270 206 284 214 300 214 H 380 C 412 196 432 150 440 110 Z`} fill="url(#hs-paint)" />
      <path d="M250 196 L 180 186 C 130 186 92 210 86 244 C 132 222 196 226 228 236 C 238 222 244 208 250 196 Z" fill="url(#hs-paint)" />
      <path d={topCase} fill="url(#hs-paint)" />
      <path d={seat} fill="#18181b" />
      <rect x="292" y="258" width="104" height="22" rx="6" fill="#27272a" />
      <path d="M487 136 C 500 138 508 146 508 153 C 507 161 497 166 486 166 Z" fill="#fff" />
    </g>

    <!-- 2. Konture -->
    <g data-hs-lines filter="url(#hs-soft)" color="#18181b">
      <g data-hs-draw stroke-width="5">
        <path d={shield} />
        <path d="M440 110 C 432 150 412 196 380 214" stroke-width="3.5" />
        <path d="M487 136 C 500 138 508 146 508 153 C 507 161 497 166 486 166" stroke-width="4" />
        <!-- Okrugli LED far na prednjem štitu (NIU motiv) -->
        <circle cx="466" cy="150" r="15" stroke-width="3.5" />
        <circle cx="466" cy="150" r="7" stroke-width="2.5" />
        <path d={floor} />
        <path d="M380 214 H 300 C 284 214 270 206 262 196" stroke-width="3" stroke-opacity="0.7" />
        <path d={tail} />
        <path d="M86 244 C 132 222 196 226 228 236" stroke-width="3.5" />
        <path d="M90 214 l -10 4" stroke-width="7" />
        <path d={seat} />
        <path d={topCase} />
        <path d="M112 162 H 186" stroke-width="2.5" stroke-opacity="0.6" />
        <path d="M150 182 V 188" />
        <path d="M492 292 L 474 208" stroke-width="6" />
        <path d="M478 288 L 462 216" stroke-width="3.5" stroke-opacity="0.7" />
        <path d="M451 112 L 447 97" stroke-width="6" />
        <path d="M424 92 L 472 100" stroke-width="7" />
        <path d="M446 96 L 432 58" stroke-width="3" />
        <path d="M422 52 C 424 44 440 42 444 50 C 446 58 432 62 424 58 Z" stroke-width="3.5" />
        <path d="M432 268 C 448 226 532 222 556 262" stroke-width="4" />
        <path d="M150 292 L 262 258" stroke-width="6" />
        <path d="M190 270 L 214 214" stroke-width="4" stroke-opacity="0.8" />
      </g>
      <rect data-hs-battery x="292" y="258" width="104" height="22" rx="6" stroke-width="3" stroke-opacity="0.8" />
    </g>
    <path data-hs-energy d="M300 280 C 260 296 212 296 160 292" stroke="#facc15" stroke-width="4" stroke-opacity="0" />
  </g>

  {wheels.map(({ cx, id, hub }) => (
    <g data-hs-wheel={id}>
      <g data-hs-render clip-path="url(#hs-reveal)">
        <circle cx={cx} cy={CY} r="54" stroke="#18181b" stroke-width="14" />
        <circle cx={cx} cy={CY} r="44" stroke="#facc15" stroke-width="3" />
      </g>
      <g data-hs-lines filter="url(#hs-soft)" color="#18181b">
        <circle data-hs-tire cx={cx} cy={CY} r="60" stroke-width="5" />
        <circle cx={cx} cy={CY} r="47" stroke-width="2.5" stroke-opacity="0.75" />
        {id === 'front' && <circle cx={cx} cy={CY} r="24" stroke-width="3" stroke-dasharray="4 6" stroke-opacity="0.85" />}
        <g data-hs-spokes stroke-width="3">
          {[0, 72, 144, 216, 288].map((a) => <path d={spoke(cx, a)} />)}
        </g>
        <circle cx={cx} cy={CY} r={hub} stroke-width="4" />
      </g>
    </g>
  ))}

  <!-- 4. Oznake kao na dizajnerskoj skici -->
  <g data-hs-callouts font-size="15" font-weight="700" letter-spacing="1.5" fill="currentColor">
    {callouts.map(({ id, dot, path, text, at, anchor }) => (
      <g data-hs-callout={id}>
        <circle cx={dot[0]} cy={dot[1]} r="4" stroke="none" />
        <path data-hs-leader d={path} fill="none" stroke-width="1.5" />
        <text x={at[0]} y={at[1]} text-anchor={anchor} stroke="none" style="text-transform: uppercase">{text}</text>
      </g>
    ))}
  </g>
</svg>
