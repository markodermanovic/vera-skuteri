---
// Hero skuter u duhu industrijskog dizajna: skica → linije → render → vožnja.
// Oblik prati sportski skuter (visok prednji štit, far u maski, retrovizori, dugo sedište sa repom,
// vidljiv zadnji amortizer, felne sa 5 krakova). Animaciju radi scripts/pages/home.ts; bez JS-a
// (ili uz reduced-motion) prikazuje se gotov crtež.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const CY = 300.7;
const wheels = [
  { id: 'rear', cx: 189.6, hub: 17 },
  { id: 'front', cx: 498.4, hub: 9 },
];
const spoke = (cx: number, a: number, r = 38) =>
  `M${cx} ${CY} L${(cx + r * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(CY + r * Math.sin((a * Math.PI) / 180)).toFixed(1)}`;

// Konture (iste putanje koriste i ispune rendera)
