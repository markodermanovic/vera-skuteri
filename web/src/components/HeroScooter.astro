---
// Hero skuter: precizan linijski crtež modela WIND (silueta precrtana sa fotografije, detalji ručno
// postavljeni po njoj), u duhu industrijskog dizajna: skica → linije → render → vožnja.
// Animaciju radi scripts/pages/home.ts; bez JS-a (ili uz reduced-motion) prikazuje se gotov crtež.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  data-hero-scooter
  viewBox="0 0 640 400"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hs-beam" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.6" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="hs-glow">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="hs-shadow">
      <stop offset="0" stop-color="#000" stop-opacity="0.45" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hs-paint" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e4e4e7" />
    </linearGradient>
    <filter id="hs-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.4" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <!-- "Četkica" rendera: pravougaonik koji se širi sleva nadesno -->
    <clipPath id="hs-reveal"><rect data-hs-reveal x="0" y="0" width="640" height="400" /></clipPath>
  </defs>

