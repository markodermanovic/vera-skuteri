const seat = 'M333.3 166.1 C336.0 164.7 335.4 160.1 334.6 158.0 C333.8 155.9 345.5 155.1 328.6 153.7 C311.7 152.2 249.5 151.6 233.1 149.3 C216.7 147.0 243.6 141.8 230.4 139.9 C217.2 138.0 166.9 137.6 153.7 137.9 C140.5 138.2 149.2 140.5 151.0 141.9 C152.8 143.3 151.6 143.9 164.4 146.6 C177.2 149.3 202.4 154.7 228.1 158.0 C253.8 161.3 301.0 165.3 318.5 166.7 C336.0 168.0 330.6 167.5 333.3 166.1 Z';
const cowl = 'M452.5 117.8 C454.3 115.2 451.7 110.0 449.2 105.8 C446.7 101.5 442.3 96.1 437.5 92.3 C432.7 88.5 424.0 83.4 420.4 83.0 C416.8 82.6 417.3 86.2 415.7 89.7 C414.1 93.2 410.0 98.4 411.0 103.7 C412.0 109.0 417.1 118.9 421.7 121.8 C426.3 124.7 433.4 121.9 438.5 121.2 C443.6 120.5 450.7 120.4 452.5 117.8 Z';

---

<svg
  data-hero-scooter
  viewBox="0 0 640 400"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hs-beam" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.6" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="hs-glow">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="hs-shadow">
      <stop offset="0" stop-color="#000" stop-opacity="0.45" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hs-paint" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e4e4e7" />
    </linearGradient>
    <filter id="hs-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <!-- "Četkica" rendera: pravougaonik koji se širi sleva nadesno -->
    <clipPath id="hs-reveal"><rect data-hs-reveal x="0" y="0" width="640" height="400" /></clipPath>
  </defs>

  <!-- 1. Skica: konstrukcione linije i perspektiva -->
  <g data-hs-sketch stroke-width="1.2" stroke-opacity="0.45" opacity="0">
    <path d="M40 358 L 610 350" />
    <path d="M70 372 L 600 368" />
    <path d="M110 300.7 L 590 300.7" stroke-dasharray="3 7" />
    <path d="M189.6 210 V 380" stroke-dasharray="3 7" />
    <path d="M498.4 210 V 380" stroke-dasharray="3 7" />
    <path d="M520 266 C 500 200 470 150 400 120" />
    <path d="M300 160 C 360 152 430 156 470 170" />
    <path d="M120 160 C 200 140 300 150 330 170" />
    <path d="M396 20 L 360 330" />
  </g>

  <!-- Brzinske linije i put -->
  <g data-hs-speed stroke-width="2.5" opacity="0">
    <path d="M14 128 H74" stroke-opacity="0.5" />
    <path d="M0 168 H48" stroke-opacity="0.35" />
    <path d="M22 206 H72" stroke-opacity="0.45" />
    <path d="M4 248 H40" stroke-opacity="0.3" />
  </g>
  <path data-hs-road d="M0 366 H640" stroke-width="3" stroke-opacity="0.45" stroke-dasharray="34 22" />
  <ellipse data-hs-shadow cx="344" cy="364" rx="240" ry="15" fill="url(#hs-shadow)" stroke="none" />

  <!-- Snop svetla -->
  <path data-hs-beam d="M456 106 L640 58 L640 178 L456 124 Z" fill="url(#hs-beam)" stroke="none" />
  <circle data-hs-glow cx="452" cy="115" r="22" fill="url(#hs-glow)" stroke="none" />

  <!-- Karoserija (lagano radi na amortizerima) -->
  <g data-hs-body>
    <!-- 3. Render: ispune ispod kontura -->
    <g data-hs-render clip-path="url(#hs-reveal)" stroke="none">
      <path d={body} fill="url(#hs-paint)" />
      <path d={cowl} fill="url(#hs-paint)" />
      <path d={seat} fill="#18181b" />
      <rect x="300" y="282" width="92" height="18" rx="5" fill="#27272a" />
      <path d="M393.6 32.1 L378.9 25.3 L379.9 41.4 L391.6 46.8 Z" fill="#18181b" />
      <path d="M386.2 61.5 L374.2 58.8 L372.8 72.2 L381.5 75.6 Z" fill="#18181b" />
    </g>

    <!-- 2. Konture -->
    <g data-hs-lines filter="url(#hs-soft)" color="#18181b">
      <g data-hs-draw stroke-width="4.5">
        <path d="M491.1 231.7 C494.2 229.0 505.0 219.1 509.5 215.6 C514.0 212.1 518.1 215.1 518.2 210.9 C518.3 206.7 514.2 196.8 510.2 190.2 C506.2 183.6 501.2 177.9 494.4 171.4 C487.6 164.9 477.9 157.6 469.3 151.3 C460.7 145.0 450.1 138.3 442.5 133.6 C434.9 128.9 426.8 124.9 423.7 123.2" />
        <path d={cowl} />
        <path d="M420.4 83.0 C419.4 84.5 416.1 88.0 414.4 91.7 C412.7 95.4 411.0 102.9 410.3 105.1" stroke-width="3" stroke-opacity="0.7" />
        <!-- Far u maski -->
        <path d="M448 104 C 456 106 462 112 460 120 C 456 124 450 124 446 122" stroke-width="3.5" />
        <path d="M391.6 114.5 C392.3 118.6 393.0 130.7 395.6 139.3 C398.2 147.9 403.8 157.2 407.0 166.1 C410.2 175.0 413.5 185.0 414.7 192.8 C415.9 200.6 416.2 206.7 414.4 213.0 C412.5 219.3 407.3 225.4 403.6 230.4 C399.9 235.4 394.8 239.2 392.2 243.1 C389.6 247.0 388.9 252.0 388.2 253.8" />
        <path d="M388.2 253.8 C382.7 251.2 366.0 243.5 355.4 238.4 C344.8 233.3 331.4 227.8 324.6 223.0 C317.8 218.2 316.2 211.8 314.5 209.6" />
        <path d="M314.5 209.6 C316.4 207.5 322.3 201.5 325.9 196.9 C329.5 192.3 334.8 187.1 336.0 182.1 C337.2 177.1 333.8 169.3 333.3 166.7" stroke-width="3.5" />
        <path d={seat} />
        <path d="M164.4 146.6 C160.5 146.4 145.2 144.0 141.0 145.3 C136.8 146.7 135.7 149.9 139.0 154.7 C142.3 159.5 154.4 168.0 161.1 174.1 C167.8 180.2 168.6 183.3 179.2 191.5 C189.8 199.7 212.3 214.4 224.8 223.0 C237.3 231.6 248.4 236.9 254.2 243.1 C260.0 249.2 258.7 257.1 259.6 259.9" />
        <path d="M161.1 174.8 C158.3 177.0 150.6 180.5 144.3 188.2 C138.1 195.9 126.3 215.1 123.6 221.0 C120.9 226.9 124.5 227.7 128.3 223.7 C132.1 219.7 140.4 203.9 146.4 196.9 C152.4 189.9 161.4 184.1 164.4 181.5" stroke-width="3.5" />
        <path d="M259.6 259.9 C257.6 268.1 245.5 300.4 247.5 309.4 C249.5 318.4 264.2 313.9 271.6 314.1 C279.0 314.3 280.1 311.5 291.8 310.8 C303.5 310.1 319.4 309.1 342.0 310.1 C364.6 311.1 412.3 321.6 427.4 316.8 C442.5 312.0 428.2 290.2 432.4 281.3 C436.6 272.4 446.4 268.6 452.5 263.2 C458.6 257.8 462.9 254.3 469.3 249.1 C475.7 243.8 487.5 234.6 491.1 231.7" />
        <path d="M532.3 246.5 C530.2 244.9 525.0 239.4 519.5 237.1 C514.0 234.8 505.1 233.0 499.4 232.4 C493.7 231.8 487.7 233.5 485.4 233.7" stroke-width="4" />
        <path d="M238.8 237.7 C234.2 236.5 221.5 232.1 211.3 230.4 C201.1 228.7 186.3 228.3 177.8 227.7 C169.3 227.1 163.3 227.1 160.4 227.0" stroke-width="4" />
        <path d="M254.9 263.9 L189.6 300.7" stroke-width="6" />
        <path d="M212.7 212.3 L201.7 214.7 L209.5 217.1 L198.5 219.6 L206.3 222.0 L195.4 224.4 L203.1 226.9 L192.2 229.3 L200.0 231.7" stroke-width="3" />
        <path d="M409.7 96.4 L386.2 89.0" stroke-width="6" />
        <path d="M395.6 109.1 L375.5 111.1" stroke-width="6" />
        <path d="M405.0 91.0 C403.6 86.2 399.1 69.7 396.9 62.2 C394.7 54.7 392.5 48.8 391.6 46.1" stroke-width="3" />
        <path d="M398.9 85.0 C397.2 83.7 391.6 78.9 388.9 76.9 C386.2 74.9 383.9 73.6 382.9 72.9" stroke-width="3" />
        <path d="M393.6 32.1 L378.9 25.3 L379.9 41.4 L391.6 46.8 Z" stroke-width="3.5" />
        <path d="M386.2 61.5 L374.2 58.8 L372.8 72.2 L381.5 75.6 Z" stroke-width="3.5" />
      </g>
      <rect data-hs-battery x="300" y="282" width="92" height="18" rx="5" stroke-width="3" stroke-opacity="0.8" />
    </g>
    <path data-hs-energy d="M300 296 C 270 308 232 308 189.6 300.7" stroke="#facc15" stroke-width="4" stroke-opacity="0" />
  </g>

  {wheels.map(({ cx, id, hub }) => (
    <g data-hs-wheel={id}>
      <g data-hs-render clip-path="url(#hs-reveal)">
        <circle cx={cx} cy={CY} r="56.3" stroke="#18181b" stroke-width="15" />
        <circle cx={cx} cy={CY} r="41.2" stroke="#facc15" stroke-width="3" />
      </g>
      <g data-hs-lines filter="url(#hs-soft)" color="#18181b">
        <circle data-hs-tire cx={cx} cy={CY} r="62.3" stroke-width="5" />
        <circle cx={cx} cy={CY} r="48.3" stroke-width="2.5" stroke-opacity="0.75" />
        {id === 'front' && <circle cx={cx} cy={CY} r="22" stroke-width="3" stroke-dasharray="4 6" stroke-opacity="0.85" />}
        <g data-hs-spokes stroke-width="3.5">
          {[0, 72, 144, 216, 288].map((a) => <path d={spoke(cx, a)} />)}
        </g>
        <circle cx={cx} cy={CY} r={hub} stroke-width="4" />
      </g>
    </g>
  ))}

</svg>
